; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Metroidvania"
run/main_scene="res://scenes/world/Mapas/Casa1.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

GameConfig="*res://scenes/GameConfig.tscn"
LocaleManager="*res://scripts/save/LocaleManager.cs"
SaveManager="*res://scripts/save/SaveManager.cs"
QuestManager="*res://scripts/quests/QuestManager.cs"
ItemDatabase="*res://scripts/items/ItemDatabase.cs"
PauseMenu="*res://scenes/ui/PauseMenu.tscn"
ConfirmPrompt="*res://scenes/ui/ConfirmPrompt.tscn"
DialogueBox="*res://scenes/ui/DialogueBox.tscn"
QuestLog="*res://scenes/ui/QuestLog.tscn"
InventoryUI="*res://scenes/ui/InventoryUI.tscn"
DeathScreen="*res://scenes/ui/DeathScreen.tscn"
RestScreen="*res://scenes/ui/RestScreen.tscn"
ZoneTitle="*res://scenes/ui/ZoneTitle.tscn"
DebugInspector="*res://scenes/ui/DebugInspector.tscn"

[display]

window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Metroidvania"

[editor_plugins]

enabled=PackedStringArray("res://addons/corridor_kit/plugin.cfg")

